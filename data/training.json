  "exercises": [
    {
      "id": "marschieren-im-sitzen",
      "name": "Marschieren im Sitzen",
      "type": "sitzen",
      "equipment": "Stuhl ohne Rollen",
      "dose": {
        "einstieg": {
          "durationSeconds": 60,
          "perSide": false,
          "label": "1 Minute"
        },
        "aufbau": {
          "durationSeconds": 120,
          "perSide": false,
          "label": "2 Minuten"
        },
        "fortgeschritten": {
          "durationSeconds": 180,
          "perSide": false,
          "label": "3 Minuten"
        }
      },
      "steps": [
        "Setz dich aufrecht auf die vordere Hälfte des Stuhls. Die Füße stehen flach auf dem Boden.",
        "Heb abwechselnd das rechte und das linke Knie etwas an, wie beim Gehen.",
        "Schwing die Arme locker mit. Atme ruhig weiter."
      ],
      "image": "uebung-marschieren-im-sitzen.webp"
    },
    {
      "id": "schultern-kreisen",
      "name": "Schultern kreisen",
      "type": "sitzen",
      "equipment": "Stuhl ohne Rollen",
      "dose": {
        "einstieg": {
          "repetitions": 5,
          "perSide": false,
          "sets": 1,
          "label": "5-mal"
        },
        "aufbau": {
          "repetitions": 8,
          "perSide": false,
          "sets": 1,
          "label": "8-mal"
        },
        "fortgeschritten": {
          "repetitions": 10,
          "perSide": false,
          "sets": 1,
          "label": "10-mal"
        }
      },
      "steps": [
        "Setz dich aufrecht hin. Die Arme hängen locker.",
        "Zieh die Schultern langsam nach oben, dann nach hinten und wieder nach unten.",
        "Danach die gleiche Zahl in die andere Richtung."
      ],
      "image": "uebung-schultern-kreisen.webp"
    },
    {
      "id": "beine-strecken-im-sitzen",
