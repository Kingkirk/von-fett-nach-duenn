      "equipment": "Stuhl ohne Rollen",
      "dose": {
        "einstieg": {
          "repetitions": 5,
          "perSide": true,
          "sets": 1,
          "label": "5-mal je Seite"
        },
        "aufbau": {
          "repetitions": 8,
          "perSide": true,
          "sets": 1,
          "label": "8-mal je Seite"
        },
        "fortgeschritten": {
          "repetitions": 10,
          "perSide": true,
          "sets": 2,
          "label": "2 Runden: 10-mal je Seite"
        }
      },
      "steps": [
        "Setz dich aufrecht hin und halte dich seitlich am Sitz fest.",
        "Streck ein Bein langsam nach vorn, bis es fast gerade ist. Kurz halten.",
        "Stell den Fuß langsam wieder ab. Dann das andere Bein."
      ],
      "image": "uebung-beine-strecken-im-sitzen.webp"
    },
    {
